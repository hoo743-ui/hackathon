# 복사해서 사용: cp .env.example .env  (.env는 Git에 커밋하지 않음)

# --- PostgreSQL ---
POSTGRES_USER=smartbin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smartbin
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- MQTT (Mosquitto) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_BACKEND_USERNAME=backend
MQTT_BACKEND_PASSWORD=change-me
MQTT_SIMULATOR_USERNAME=simulator
MQTT_SIMULATOR_PASSWORD=change-me
MQTT_DEVICE_USERNAME=device_001
MQTT_DEVICE_PASSWORD=change-me
MQTT_TOPIC_PREFIX=smartbin

# --- Backend ---
API_HOST=0.0.0.0
API_PORT=8000
API_CONTROL_TOKEN=change-me-long-random-string
# 외부 AI 분류 프로그램 전용 토큰 (POST /api/detections). 제어 권한 없음
AI_API_TOKEN=change-me-ai-token
AI_CONFIDENCE_THRESHOLD=0.6
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
COMMAND_ACK_TIMEOUT_SEC=15
COMMAND_EXPIRES_SEC=3
DEVICE_OFFLINE_AFTER_SEC=30

# --- Web (Vite) ---
# 비워 두면 웹을 연 주소의 호스트:8000 으로 자동 접속 (다른 기기 브라우저에서도 동작)
VITE_API_BASE_URL=
VITE_WS_URL=

# --- Mobile (Expo) — 실기기에서는 Mac의 LAN IP 사용 ---
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:8000
EXPO_PUBLIC_WS_URL=ws://192.168.0.10:8000/ws/dashboard
MQTT_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1
BIN_FULL_THRESHOLD_PERCENT=95
VITE_DATA_MODE=live

# --- Hardware Abstraction Layer ---
# SIMULATOR: 백엔드 내장 가상 장치(source=simulator만 수락) / ESP32_REAL: 실제 ESP32(source=hardware만 수락)
HARDWARE_MODE=EDGE_SERIAL
SIMULATOR_AUTOSTART=false
SIMULATOR_SCENARIO=mixed
SIMULATOR_INTERVAL_SEC=3

# --- 카메라 노트북 연동 (EDGE_SERIAL) ---
EDGE_BIN_DEVICE_ID=DEVICE_001
UPLOAD_DIR=data/images
CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+|172\.(1[6-9]|2\d|3[01])\.\d+\.\d+|10\.\d+\.\d+\.\d+)(:\d+)?$
