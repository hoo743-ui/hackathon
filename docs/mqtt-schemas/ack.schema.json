{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-recycle.local/schemas/ack.schema.json",
  "description": "v1(success/message/executed_at)과 v1.1(status/error_code/completed_at)을 모두 수락한다.",
  "properties": {
    "message_type": {
      "anyOf": [
        {
          "const": "ack",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Message Type"
    },
    "message_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Message Id"
    },
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "device_id": {
      "pattern": "^DEVICE_\\d{3}$",
      "title": "Device Id",
      "type": "string"
    },
    "success": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Success"
    },
    "status": {
      "anyOf": [
        {
          "enum": [
            "SUCCEEDED",
            "FAILED"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status"
    },
    "error_code": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "message": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Message"
    },
    "executed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Executed At"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    }
  },
  "required": [
    "command_id",
    "device_id"
  ],
  "title": "AckPayload",
  "type": "object"
}
