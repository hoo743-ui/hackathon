# 복사해서 사용:  Windows: copy .env.example .env   /   macOS·Linux: cp .env.example .env
# .env 는 Git 에 올리지 않는다.

# YOLO 모델 경로 (camera-computer/ 기준 상대경로 또는 절대경로)
MODEL_PATH=models/best_model.pt
CONFIDENCE_THRESHOLD=0.5

# 카메라 번호 (0 = 기본 카메라). test_camera.py --scan 으로 확인
CAMERA_INDEX=0

# Arduino UNO 등 USB 시리얼 포트. auto = Arduino 계열 장치가 1개일 때만 자동 선택
#   Windows: COM5   macOS: /dev/cu.usbmodem1101   Linux: /dev/ttyACM0 또는 /dev/ttyUSB0
SERIAL_PORT=auto
BAUD_RATE=9600

# (선택) ESP32 DevKitC V4 USB 포트 — 로그 확인용
#   Windows: COM6   macOS: /dev/cu.usbserial-0001   Linux: /dev/ttyUSB0
ESP32_SERIAL_PORT=
ESP32_BAUD_RATE=115200
