# SMART RECYCLE — 팀 공통 설정 (Git 으로 배포). git pull 하면 카메라 컴퓨터에 그대로 적용된다.
# 이 파일의 값은 로컬 .env 보다 우선한다. 비밀값(AI_API_TOKEN)과 기기별 선택(COM 포트·카메라 번호·서버 주소)은 넣지 않는다
# — 그건 카메라 컴퓨터의 edge/.env (Git 제외, pull 해도 유지) 또는 프로그램 '설정' 화면에서 관리한다.
DEVICE_ID=CAMERA_001

# YOLO (추론 전용) — 오인식(빈 배경을 Plastic 0.52 로 인식) 방지를 위해 0.5 → 0.65
CONFIDENCE_THRESHOLD=0.65
IMG_SIZE=640
YOLO_DEVICE=auto

# 투입 1회 = 분류 1회
STABLE_FRAMES=4
STABLE_MIN_SEC=0.4
CLEAR_SEC=2.0
SEND_COOLDOWN=2.0

# 서버 연결 · 맥북 IP 자동 추적
DISCOVERY=true
DISCOVERY_PORT=50505
HEARTBEAT_SEC=5
HTTP_TIMEOUT_SEC=5
UPLOAD_MAX_ATTEMPTS=5

# 하드웨어 (Arduino UNO · ESP32)
HW_ENABLED=true
HW_BAUD=9600
ESP32_BAUD=115200
ACK_TIMEOUT_SEC=10
HW_BUSY_SEC=6.5

# HC-SR04
SENSOR_TIMEOUT_SEC=5
SENSOR_SEND_SEC=3
FORWARD_SENSOR=true

SHOW_WINDOW=true
