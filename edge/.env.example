# 복사: cp .env.example .env  (Windows: copy .env.example .env)  — .env 는 Git에 올리지 않는다

# --- 맥북 백엔드 (반드시 맥북의 LAN IP. localhost 금지) ---
BACKEND_URL=http://192.168.0.10:8000
# 맥북 저장소 루트 .env 의 AI_API_TOKEN 과 같은 값
AI_API_TOKEN=
DEVICE_ID=CAMERA_001

# --- 카메라 / YOLO (추론 전용 · 학습 없음) ---
CAMERA_INDEX=0
# 모델 경로 우선순위: ① MODEL_PATH ② 실행 폴더 models/best_model.pt ③ 프로그램 설정 화면에서 선택
MODEL_PATH=models/best_model.pt
CONFIDENCE_THRESHOLD=0.5
# 추론 입력 크기, 장치: auto(NVIDIA CUDA→CPU) | cpu | 0 | mps
IMG_SIZE=640
YOLO_DEVICE=auto
SEND_COOLDOWN=2.0
# 같은 클래스가 연속 STABLE_FRAMES 프레임 + STABLE_MIN_SEC 초 이상 보여야 1회 분류
STABLE_FRAMES=4
STABLE_MIN_SEC=0.4
# 물체가 CLEAR_SEC 초 동안 사라져야 다음 투입으로 인정
CLEAR_SEC=1.0
SHOW_WINDOW=true
# 원본 프레임도 저장하려면 폴더 지정 (비우면 저장 안 함)
SAVE_RAW_DIR=

# --- 하드웨어: Arduino UNO (trush.ino) USB 시리얼 ---
HW_ENABLED=true
# auto = Arduino VID 장치가 1개일 때만 자동 선택. 확인 후 직접 지정 권장
#   Windows: COM5   macOS: /dev/cu.usbmodem1101   Linux: /dev/ttyACM0
HW_SERIAL_PORT=auto
HW_BAUD=9600
# 구 펌웨어(trush.ino, 응답 없음)일 때: 동작 시간(약 6.1초) 동안 새 명령을 보내지 않음
HW_BUSY_SEC=6.5
# uno_controller 펌웨어 ACK:DONE 대기 한도
ACK_TIMEOUT_SEC=10

# --- HC-SR04 ×1 (uno_controller 펌웨어가 DIST:<cm> 를 보낼 때) ---
# 센서가 설치된 칸 (BIN_001 플라스틱 · BIN_002 금속 · BIN_003 종이 · BIN_004 유리) — 실제 설치 위치로
SENSOR_BIN_ID=
# 빈 통일 때 센서~바닥 실측 거리(cm). 적재율 = (1 - 측정거리/이 값) × 100. 비우면 적재율 계산 안 함
EMPTY_DISTANCE_CM=
# 이 시간 동안 거리값이 없으면 SENSOR_DISCONNECTED
SENSOR_TIMEOUT_SEC=5
SENSOR_SEND_SEC=3
# ESP32 가 Wi-Fi 로 거리값을 직접 서버에 보내도록 설정했다면 false (중복 방지)
FORWARD_SENSOR=true

# --- ESP32 DevKitC V4 USB (esp32_bridge 펌웨어: UNO 링크·Wi-Fi 상태 확인, 읽기 전용) ---
#   Windows: COM6   macOS: /dev/cu.usbserial-0001 (CP2102)   Linux: /dev/ttyUSB0
ESP32_SERIAL_PORT=
ESP32_BAUD=115200

# --- 전송 ---
HTTP_TIMEOUT_SEC=5
UPLOAD_MAX_ATTEMPTS=5
HEARTBEAT_SEC=5
OUTBOX_DIR=outbox
